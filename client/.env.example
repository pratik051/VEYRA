# ================================================================
# VEYRA / SajiloMarts — Client Environment Variables Template
# ================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.
# Configure production values in Vercel Dashboard → Environment Variables.
#
# SECURITY RULES:
# - VITE_ variables are BROWSER-VISIBLE — never put private secrets here
# - Firebase Client SDK values below are PUBLIC identifiers (by design)
# - Backend URL is the only non-Firebase value needed here
# ================================================================

# --- Backend API ---
# Set to your Render backend URL in production (Vercel uses rewrite proxy if blank)
VITE_API_URL=

# --- Firebase Client SDK (public browser-safe identifiers) ---
# These are NOT private secrets — they are required to be public for Firebase Auth to work
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_GOOGLE_CLIENT_ID=142195013313-2nb8cjd7h0eu871sg3v2i4ev9406g75l.apps.googleusercontent.com
