# ================================================================
# SajiloMarts — Client Environment Variables Template
# ================================================================
# For Local Development:
#   Copy this file to client/.env.local and fill in values.
#   client/.env.local is gitignored and will never be committed.
#
# For Production Deployment (Cloudflare Pages):
#   Set these environment variables in:
#   Cloudflare Dashboard → Workers & Pages → Your Project → Settings → Environment variables
#
# SECURITY RULES:
# - VITE_ variables are BROWSER-VISIBLE (bundled in client assets).
# - Do NOT put backend private secrets, DB passwords, or private keys here.
# ================================================================

# --- Backend API URL ---
# In Production (Cloudflare Pages): Set to your Koyeb backend URL (e.g., https://your-app-name.koyeb.app)
# In Local Dev: Leave blank to use Vite dev proxy to http://localhost:5000, or set explicitly.
VITE_API_URL=https://your-koyeb-backend-url.koyeb.app

# --- Firebase Client SDK (Public Browser-Safe Identifiers) ---
# These are required in the client bundle for Firebase Auth (Google Sign-In, OTP).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Google OAuth Web Client ID ---
VITE_GOOGLE_CLIENT_ID=
