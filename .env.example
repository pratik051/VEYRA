# ==========================================
# VEYRA - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# ------------------------------------------
# 1. RENDER (BACKEND SERVICE) VARIABLES
# ------------------------------------------
# Port is provided dynamically by Render (defaults to 10000 on Render, 3000 locally)
PORT=10000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/veyra?retryWrites=true&w=majority
MONGO_URI=${MONGODB_URI}

# CORS / Allowed Frontend Origin
FRONTEND_URL=https://your-veyra-app.vercel.app

# Admin Credentials
ADMIN_EMAIL=admin@veyra.com
ADMIN_PASSWORD=YourSecurePassword123!

# AI Assistant
GEMINI_API_KEY=your_gemini_api_key_here

# Payment Gateways (Nepal)
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q(
ESEWA_BASE_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
KHALTI_SECRET_KEY=your_khalti_secret_key
KHALTI_CHECKOUT_URL=https://pay.khalti.com
PAYMENT_WEBHOOK_SECRET=your_webhook_secret

# Email / SMTP
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Authentication (Google & Firebase)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# ------------------------------------------
# 2. VERCEL (FRONTEND UI) VARIABLES
# ------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-veyra-app.vercel.app
RENDER_BACKEND_URL=https://your-veyra-backend.onrender.com
NEXT_PUBLIC_API_URL=https://your-veyra-backend.onrender.com

# Public Client Keys (Required on Vercel)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
NEXT_PUBLIC_KHALTI_PUBLIC_KEY=your_khalti_public_key

# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=veyra-np.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=veyra-np
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=veyra-np.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
