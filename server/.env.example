# ============================================================
# SajiloMarts — Server Environment Variables Template
# ============================================================
# For Local Development:
#   Copy this file to server/.env.local and fill in real values.
#   server/.env.local is gitignored and will never be committed.
#
# For Production Deployment (Koyeb Free Tier):
#   Set these environment variables in:
#   Koyeb Dashboard → Your Service → Settings → Environment Variables
# ============================================================

# --- Database (MongoDB Atlas Free Tier - M0 Sandbox) ---
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# IMPORTANT: In MongoDB Atlas -> Network Access, whitelist "0.0.0.0/0" (Allow Access from Anywhere)
MONGODB_URI=

# --- Application & Server Config ---
NODE_ENV=production
PORT=5000
# Set to your Cloudflare Pages frontend URL (e.g., https://sajilomarts.pages.dev or https://www.sajilomarts.tech)
FRONTEND_URL=https://your-frontend.pages.dev
# Optional comma-separated list of additional allowed origins for CORS
ALLOWED_ORIGINS=https://your-frontend.pages.dev,https://www.sajilomarts.tech

# --- Authentication & Session Security ---
JWT_SECRET=
SESSION_SECRET=

# --- Admin Account (Seeded on first startup if not already existing in MongoDB) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Firebase Admin SDK & Auth (Server-side token verification) ---
# Provide either individual values OR FIREBASE_SERVICE_ACCOUNT JSON string:
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Or raw JSON string:
FIREBASE_SERVICE_ACCOUNT=

# --- Google OAuth Credentials ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- SMTP / Automated Customer Emails (Gmail App Password or SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=SajiloMarts
EMAIL_FROM=

# --- Payment Gateways (Nepal: eSewa, Khalti, MyPay) ---
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
MYPAY_MERCHANT_ID=

# --- Business Logic & Pricing Engine ---
INDIA_NPR_CONVERSION_RATE=1.65
SERVICE_CHARGE_PERCENT=20
DELIVERY_CHARGE_NPR=200
