# ============================================================
# VEYRA / SajiloMarts — Server Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# Configure production values in Render Dashboard → Environment.
# ============================================================

# --- Database ---
MONGODB_URI=
MONGO_URI=

# --- Authentication ---
JWT_SECRET=
SESSION_SECRET=

# --- Admin Credentials (seeded on first startup) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Firebase Admin SDK (server-side only) ---
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Gemini AI ---
GEMINI_API_KEY=

# --- SMTP / Email ---
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Payment Gateways ---
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
MYPAY_MERCHANT_ID=

# --- App Config ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# --- Business Logic ---
INDIA_NPR_CONVERSION_RATE=1.65
SERVICE_CHARGE_PERCENT=20
DELIVERY_CHARGE_NPR=200
